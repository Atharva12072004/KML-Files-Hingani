<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Hingani (Man, Satara) - Survey No. 101 Sub-plots - APPROXIMATE Boundaries (v2, corrected)</name>
  <description><![CDATA[
    APPROXIMATE, DIGITIZED boundary polygons for Survey No. 101 sub-plots (101/2, 101/3, 101/4, 101/5),
    Hingani village, Man taluka, Satara district, Maharashtra.<br/><br/>
    <b>Method:</b> traced the yellow boundary line from each report's satellite-map image, calibrated scale using
    the line's own centerline length (averaging its outer and inner edge, to correct for the line's drawn thickness)
    against the report's stated compound length, oriented using the printed North arrow, and anchored using the
    report's given Lat/Long as the polygon's centroid.<br/><br/>
    <b>Accuracy (v2, corrected):</b> digitized area vs. reported area is within -9.2% to +1.4% across the 4 plots
    (avg abs. error ~5%) - see per-plot notes below for exact figures. This is a strong visual approximation,
    NOT survey-grade or legally valid data. For anything official, use a licensed surveyor or the government
    cadastral portal (Bhulekh / MahaBhunakasha).
  ]]></description>

  <Style id="plotPolyStyle">
    <LineStyle><color>ff00ffff</color><width>3</width></LineStyle>
    <PolyStyle><color>4d00ffff</color></PolyStyle>
  </Style>

  <Placemark>
    <name>Survey 101/2 (approx. boundary, corrected)</name>
    <styleUrl>#plotPolyStyle</styleUrl>
    <description><![CDATA[
      <b>Village:</b> Hingani | <b>Taluka:</b> Man | <b>District:</b> Satara<br/>
      <b>Reported Area:</b> 6 Ha 98 R 92 Sq.Mtr (69,892 Sq.Mtr / 17.2707 Acre / 698.92 Guntha)<br/>
      <b>Reported Compound Length:</b> 1072.48 m<br/>
      <b>Reported Boundary:</b> West: 101/1, 101/3<br/><br/>
      <b>Digitized polygon area:</b> ~6.35 Ha (vs reported 6.9892 Ha -&gt; -9.2% difference)<br/>
      <i>Boundary digitized from report map image using centerline calibration - approximate, not survey-grade.</i>
    ]]></description>
    <Polygon>
      <tessellate>1</tessellate>
      <outerBoundaryIs>
        <LinearRing>
          <coordinates>74.8882058,17.6583982,0 74.8857291,17.6574846,0 74.8862945,17.6553706,0 74.8879477,17.6555287,0 74.8881628,17.6570396,0 74.8882058,17.6583982,0</coordinates>
